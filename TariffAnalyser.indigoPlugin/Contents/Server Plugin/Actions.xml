<?xml version="1.0" encoding="UTF-8"?>
<Actions>

    <!-- Generate the Tariff Comparison HTML report (schedulable). -->
    <Action id="generateReport" uiPath="PluginActions">
        <Name>Generate Tariff Comparison Report</Name>
        <CallbackMethod>actionGenerateReport</CallbackMethod>
        <ConfigUI>
            <Field id="reportDays" type="menu" defaultValue="30">
                <Label>Date range</Label>
                <List>
                    <Option value="7">Last 7 days</Option>
                    <Option value="14">Last 14 days</Option>
                    <Option value="30">Last 30 days</Option>
                    <Option value="60">Last 60 days</Option>
                    <Option value="90">Last 90 days</Option>
                    <Option value="180">Last 180 days</Option>
                    <Option value="365">Last 365 days (full year)</Option>
                </List>
            </Field>
        </ConfigUI>
    </Action>

    <!-- Refresh the Octopus Agile price cache (auto-run nightly; expose as
         schedulable action for manual / override use). -->
    <Action id="updatePrices" uiPath="PluginActions">
        <Name>Update Octopus Agile Price Data</Name>
        <CallbackMethod>actionUpdatePrices</CallbackMethod>
    </Action>

    <!-- Refresh the daily summary table (auto-run nightly at 02:00). -->
    <Action id="updateDailySummary" uiPath="PluginActions">
        <Name>Update Daily Energy Summary</Name>
        <CallbackMethod>actionUpdateDailySummary</CallbackMethod>
        <ConfigUI>
            <Field id="rollingDays" type="menu" defaultValue="7">
                <Label>Days to refresh</Label>
                <List>
                    <Option value="1">Yesterday only</Option>
                    <Option value="3">Last 3 days</Option>
                    <Option value="7">Last 7 days (recommended)</Option>
                    <Option value="14">Last 14 days</Option>
                    <Option value="30">Last 30 days</Option>
                </List>
            </Field>
        </ConfigUI>
    </Action>

    <!-- Energy Summary as an action (so it can be scheduled). -->
    <Action id="energySummary" uiPath="PluginActions">
        <Name>Generate Energy Summary</Name>
        <CallbackMethod>actionEnergySummary</CallbackMethod>
    </Action>

</Actions>
