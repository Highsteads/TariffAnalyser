<?xml version="1.0" encoding="UTF-8"?>
<Actions>

    <Action id="generateReport" uiPath="PluginActions">
        <Name>Generate Tariff Comparison Report</Name>
        <CallbackMethod>actionGenerateReport</CallbackMethod>
        <ConfigUI>
            <Field id="reportDays" type="menu" defaultValue="30">
                <Label>Date range</Label>
                <List>
                    <Option value="30">Last 30 days</Option>
                    <Option value="60">Last 60 days</Option>
                    <Option value="90">Last 90 days</Option>
                    <Option value="180">Last 180 days</Option>
                    <Option value="365">Last 365 days (full year)</Option>
                </List>
            </Field>
        </ConfigUI>
    </Action>

    <Action id="updatePrices" uiPath="PluginActions">
        <Name>Update Octopus Agile Price Data</Name>
        <CallbackMethod>actionUpdatePrices</CallbackMethod>
    </Action>

    <Action id="dailyEnergyReport" uiPath="PluginActions">
        <Name>Generate Daily Energy Summary (yesterday)</Name>
        <CallbackMethod>actionDailyEnergyReport</CallbackMethod>
    </Action>

    <Action id="weeklyEnergyReport" uiPath="PluginActions">
        <Name>Generate Weekly Energy Summary (last 7 days)</Name>
        <CallbackMethod>actionWeeklyEnergyReport</CallbackMethod>
    </Action>

    <Action id="monthlyEnergyReport" uiPath="PluginActions">
        <Name>Generate Monthly Energy Summary (last calendar month)</Name>
        <CallbackMethod>actionMonthlyEnergyReport</CallbackMethod>
    </Action>

    <Action id="yearlyEnergyReport" uiPath="PluginActions">
        <Name>Generate Yearly Energy Summary (last calendar year)</Name>
        <CallbackMethod>actionYearlyEnergyReport</CallbackMethod>
    </Action>

    <Action id="updateDailySummary" uiPath="PluginActions">
        <Name>Update Daily Energy Summary</Name>
        <CallbackMethod>actionUpdateDailySummary</CallbackMethod>
        <ConfigUI>
            <Field id="rollingDays" type="menu" defaultValue="7">
                <Label>Days to refresh</Label>
                <List>
                    <Option value="1">Yesterday only</Option>
                    <Option value="3">Last 3 days</Option>
                    <Option value="7">Last 7 days (recommended)</Option>
                    <Option value="14">Last 14 days</Option>
                    <Option value="30">Last 30 days</Option>
                </List>
            </Field>
        </ConfigUI>
    </Action>

    <Action id="openEnergyDashboard" uiPath="PluginActions">
        <Name>Open Energy Dashboard</Name>
        <CallbackMethod>actionOpenEnergyDashboard</CallbackMethod>
    </Action>

</Actions>
