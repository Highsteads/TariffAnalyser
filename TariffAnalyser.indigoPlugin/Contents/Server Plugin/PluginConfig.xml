<?xml version="1.0" encoding="UTF-8"?>
<PluginConfig>

    <Field id="dbPathLabel" type="label">
        <Label>--- Energy Data Source ---</Label>
    </Field>

    <Field id="dbPath" type="textfield" defaultValue="">
        <Label>Timeseries DB path</Label>
        <Description>Leave blank to use the SigenEnergyManager default path automatically.</Description>
    </Field>

    <Field id="outputDirLabel" type="label">
        <Label>--- Report Output ---</Label>
    </Field>

    <Field id="outputDir" type="textfield" defaultValue="">
        <Label>Output folder</Label>
        <Description>Leave blank to use /Library/Application Support/Perceptive Automation/TariffAnalyser/</Description>
    </Field>

    <Field id="openOnScheduledReport" type="checkbox" defaultValue="false">
        <Label>Open report in LibreOffice when generated by a schedule/action</Label>
    </Field>

    <Field id="tariffLabel" type="label">
        <Label>--- Tariff Settings ---</Label>
    </Field>

    <Field id="octopusRegion" type="menu" defaultValue="F">
        <Label>Octopus region (for Agile prices)</Label>
        <List>
            <Option value="A">A - Eastern England</Option>
            <Option value="B">B - East Midlands</Option>
            <Option value="C">C - London</Option>
            <Option value="D">D - Merseyside and North Wales</Option>
            <Option value="E">E - West Midlands</Option>
            <Option value="F">F - North East England</Option>
            <Option value="G">G - North West England</Option>
            <Option value="H">H - Southern England</Option>
            <Option value="J">J - South East England</Option>
            <Option value="K">K - South West England</Option>
            <Option value="L">L - Yorkshire</Option>
            <Option value="M">M - South Scotland</Option>
            <Option value="N">N - North Scotland</Option>
            <Option value="P">P - North Wales and Mersey</Option>
        </List>
    </Field>

    <Field id="exportTariffKey" type="menu" defaultValue="outgoing_12p">
        <Label>Export tariff to use in comparisons</Label>
        <List>
            <Option value="outgoing_12p">Octopus Outgoing 12p flat (actual)</Option>
            <Option value="agile_outgoing">Octopus Agile Outgoing (variable)</Option>
            <Option value="seg_min">SEG Minimum (Ofgem floor - 1.63p)</Option>
            <Option value="seg_typical">SEG Typical (7.5p)</Option>
        </List>
    </Field>

    <Field id="gasUnitRateP" type="textfield" defaultValue="6.09">
        <Label>Gas unit rate (pence/kWh)</Label>
        <Description>Used for daily_summary gas cost calculations. Update if your rate changes.</Description>
    </Field>

    <Field id="defaultDays" type="menu" defaultValue="30">
        <Label>Default report date range</Label>
        <List>
            <Option value="30">Last 30 days</Option>
            <Option value="60">Last 60 days</Option>
            <Option value="90">Last 90 days</Option>
            <Option value="180">Last 180 days</Option>
            <Option value="365">Last 365 days</Option>
        </List>
    </Field>

    <Field id="octopusLabel" type="label">
        <Label>--- Octopus Energy Credentials ---</Label>
    </Field>

    <Field id="octopusHelp" type="label" fontSize="mini" alignWithControl="true">
        <Label>Read from IndigoSecrets.py first (OCTOPUS_API_KEY / OCTOPUS_MPAN / OCTOPUS_SERIAL / OCTOPUS_EXPORT_MPAN / OCTOPUS_EXPORT_SERIAL / OCTOPUS_GAS_MPRN / OCTOPUS_GAS_SERIAL). The fields below are the fallback for users without IndigoSecrets.py — fill them in only if IndigoSecrets is not set up.</Label>
    </Field>

    <Field id="octopusApiKey" type="textfield" secure="true" defaultValue="">
        <Label>Octopus API key</Label>
    </Field>
    <Field id="octopusMpan" type="textfield" defaultValue="">
        <Label>Import MPAN</Label>
    </Field>
    <Field id="octopusSerial" type="textfield" defaultValue="">
        <Label>Import meter serial</Label>
    </Field>
    <Field id="octopusExportMpan" type="textfield" defaultValue="">
        <Label>Export MPAN</Label>
    </Field>
    <Field id="octopusExportSerial" type="textfield" defaultValue="">
        <Label>Export meter serial</Label>
    </Field>
    <Field id="octopusGasMprn" type="textfield" defaultValue="">
        <Label>Gas MPRN</Label>
    </Field>
    <Field id="octopusGasSerial" type="textfield" defaultValue="">
        <Label>Gas meter serial</Label>
    </Field>

</PluginConfig>
