<?xml version="1.0" encoding="UTF-8"?>
<MenuItems>

    <!-- ==================================================================
         Energy Summary
         One-page HTML summary of savings vs current tariff for:
           Today, Yesterday, This week, This month, This year.
         Opens in default browser.
         ================================================================== -->
    <MenuItem id="energySummary">
        <Name>Energy Summary (today / yesterday / week / month / year)</Name>
        <CallbackMethod>energySummary</CallbackMethod>
    </MenuItem>

    <!-- ==================================================================
         Tariff Comparison
         What would the same energy data have cost on every UK tariff over
         a chosen lookback period?  Single dropdown - no date pickers.
         Opens HTML in default browser.
         ================================================================== -->
    <MenuItem id="tariffComparison">
        <Name>Tariff Comparison (which tariff would be cheapest?)</Name>
        <CallbackMethod>tariffComparison</CallbackMethod>
        <ButtonTitle>Run Comparison</ButtonTitle>
        <ConfigUI>
            <Field id="instructions" type="label" fontSize="small">
                <Label>Compares your actual half-hourly energy usage against every UK tariff (Tracker, Flexible, Go, Intelligent Go, Flux, Intelligent Flux, Agile) over the chosen period. Highlights which would have been cheapest - useful before switching.</Label>
            </Field>
            <Field id="lookbackDays" type="menu" defaultValue="30">
                <Label>Comparison period:</Label>
                <List>
                    <Option value="7">Last 7 days</Option>
                    <Option value="14">Last 14 days</Option>
                    <Option value="30">Last 30 days (recommended)</Option>
                    <Option value="60">Last 60 days</Option>
                    <Option value="90">Last 90 days</Option>
                    <Option value="180">Last 180 days</Option>
                    <Option value="365">Last 365 days (full year)</Option>
                </List>
            </Field>
        </ConfigUI>
    </MenuItem>

    <MenuItem id="toggleTimestamps">
        <Name>Toggle Timestamps in Log (on/off)</Name>
        <CallbackMethod>menuToggleTimestamps</CallbackMethod>
    </MenuItem>

    <MenuItem id="sep1" isSeparator="true"/>

    <MenuItem id="showPluginInfo">
        <Name>Show Plugin Info</Name>
        <CallbackMethod>showPluginInfo</CallbackMethod>
    </MenuItem>

</MenuItems>
